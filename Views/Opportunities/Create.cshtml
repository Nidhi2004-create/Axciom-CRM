@model AcxiomCRM.ViewModels.OpportunityCreateEditViewModel
@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-briefcase text-primary me-2"></i>New Opportunity</h3>
                <p class="text-muted small mb-0">Record a commercial deal with pipeline stage, value and forecast probability.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Opportunities
            </a>
        </div>

        <div class="crm-card p-4">
            <form asp-action="Create" method="post" id="opportunityForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="OpportunityName" class="form-label">Opportunity Name <span class="text-danger">*</span></label>
                        <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Apex Cloud Integration Project" autofocus />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label">Customer Account <span class="text-danger">*</span></label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomersList">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label">Originating Lead (Optional)</label>
                        <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadsList">
                            <option value="">-- None / Direct Opportunity --</option>
                        </select>
                        <span asp-validation-for="LeadId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label">Deal Amount (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="Amount" class="form-control" id="oppAmountInput" type="number" step="1000" min="0.01" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                        <div class="form-text small text-muted">Amount must be greater than 0 for active sales opportunities.</div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Probability" class="form-label">Probability (0 - 100%) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="Probability" class="form-control" id="oppProbabilityInput" type="number" min="0" max="100" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="Probability" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Stage" class="form-label">Pipeline Stage <span class="text-danger">*</span></label>
                        <select asp-for="Stage" class="form-select" id="oppStageSelect">
                            <option value="Qualification">Qualification (20%)</option>
                            <option value="Proposal">Proposal (50%)</option>
                            <option value="Negotiation">Negotiation (80%)</option>
                            <option value="Won">Won (100%)</option>
                            <option value="Lost">Lost (0%)</option>
                        </select>
                        <span asp-validation-for="Stage" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date <span class="text-danger">*</span></label>
                        <input asp-for="ExpectedCloseDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" id="oppCloseDateInput" />
                        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        <div class="form-text small text-muted">Cannot be in the past for active opportunities.</div>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label">Assign Deal Owner</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList">
                                <option value="">-- Assign to User --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    }

                    <!-- Real-time Weighted Pipeline Preview -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold d-block">Derived Weighted Pipeline Forecast</span>
                                <h4 class="fw-bold text-success mb-0" id="oppWeightedPreview">₹0</h4>
                            </div>
                            <span class="badge badge-soft-primary small">Formula: Amount × Probability / 100</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">Deal Notes &amp; Commercial Terms</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="SLA requirements, license terms, partner details..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Save Opportunity
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const amountEl = document.getElementById('oppAmountInput');
        const probEl = document.getElementById('oppProbabilityInput');
        const stageEl = document.getElementById('oppStageSelect');
        const previewEl = document.getElementById('oppWeightedPreview');

        function updateWeighted() {
            const amount = parseFloat(amountEl.value) || 0;
            const prob = parseFloat(probEl.value) || 0;
            const weighted = (amount * prob) / 100;
            previewEl.textContent = '₹' + weighted.toLocaleString('en-IN', { maximumFractionDigits: 2 });
        }

        stageEl.addEventListener('change', function () {
            if (this.value === 'Won') {
                probEl.value = 100;
            } else if (this.value === 'Lost') {
                probEl.value = 0;
            } else if (this.value === 'Qualification') {
                probEl.value = 20;
            } else if (this.value === 'Proposal') {
                probEl.value = 50;
            } else if (this.value === 'Negotiation') {
                probEl.value = 80;
            }
            updateWeighted();
        });

        amountEl.addEventListener('input', updateWeighted);
        probEl.addEventListener('input', updateWeighted);
        updateWeighted();
    </script>
}
