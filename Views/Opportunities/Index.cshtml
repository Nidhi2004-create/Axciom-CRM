@model AcxiomCRM.ViewModels.OpportunityIndexViewModel
@{
    ViewData["Title"] = "Opportunity Pipeline";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-briefcase-fill text-primary me-2"></i>Opportunities &amp; Pipeline</h3>
        <p class="text-muted small mb-0">Track active commercial deals, stages, probabilities and weighted forecast.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> New Opportunity
    </a>
</div>

<!-- Pipeline Summary Ribbon -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="crm-card crm-kpi-card">
            <div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Open Pipeline</span>
                <h4 class="fw-bold text-primary mb-0">₹@Model.TotalPipelineValue.ToString("N0")</h4>
            </div>
            <div class="crm-kpi-icon badge-soft-primary">
                <i class="bi bi-currency-rupee"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="crm-card crm-kpi-card">
            <div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Weighted Forecast</span>
                <h4 class="fw-bold text-success mb-0">₹@Model.TotalWeightedValue.ToString("N0")</h4>
            </div>
            <div class="crm-kpi-icon badge-soft-success">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="crm-card crm-kpi-card">
            <div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Total Deals</span>
                <h4 class="fw-bold text-dark mb-0">@Model.TotalItems</h4>
            </div>
            <div class="crm-kpi-icon badge-soft-info">
                <i class="bi bi-layers-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="crm-card crm-kpi-card">
            <div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Win Ratio Base</span>
                <h4 class="fw-bold text-warning mb-0">
                    @(Model.TotalPipelineValue > 0 ? ((Model.TotalWeightedValue / Model.TotalPipelineValue) * 100).ToString("N0") + "%" : "0%")
                </h4>
            </div>
            <div class="crm-kpi-icon badge-soft-warning">
                <i class="bi bi-pie-chart-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">Search Opportunities</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Deal name, customer..." />
            </div>
        </div>
        @if (ViewBag.CustomersList != null)
        {
            <div class="col-md-2">
                <label class="form-label small text-muted">Customer</label>
                <select name="customerFilter" class="form-select form-select-sm" asp-items="ViewBag.CustomersList">
                    <option value="">All Customers</option>
                </select>
            </div>
        }
        <div class="col-md-2">
            <label class="form-label small text-muted">Stage</label>
            <select name="stageFilter" class="form-select form-select-sm">
                <option value="">All Stages</option>
                <option value="Qualification" selected="@(Model.StageFilter == "Qualification")">Qualification</option>
                <option value="Proposal" selected="@(Model.StageFilter == "Proposal")">Proposal</option>
                <option value="Negotiation" selected="@(Model.StageFilter == "Negotiation")">Negotiation</option>
                <option value="Won" selected="@(Model.StageFilter == "Won")">Won</option>
                <option value="Lost" selected="@(Model.StageFilter == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Status</label>
            <select name="statusFilter" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Open" selected="@(Model.StatusFilter == "Open")">Open</option>
                <option value="Won" selected="@(Model.StatusFilter == "Won")">Won</option>
                <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
            </select>
        </div>
        @if (ViewBag.UsersList != null)
        {
            <div class="col-md-2">
                <label class="form-label small text-muted">Owner</label>
                <select name="assignedUserFilter" class="form-select form-select-sm" asp-items="ViewBag.UsersList">
                    <option value="">All Owners</option>
                </select>
            </div>
        }
        <div class="col-md-1 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel-fill"></i></button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-clockwise"></i></a>
        </div>
    </form>
</div>

<!-- Opportunities Table -->
<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Stage</th>
                    <th>Amount</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Opportunities.Any())
                {
                    @foreach (var opp in Model.Opportunities)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none text-primary">
                                    @opp.OpportunityName
                                </a>
                                @if (opp.Status == "Won")
                                {
                                    <span class="badge badge-soft-success ms-1">Won</span>
                                }
                                else if (opp.Status == "Lost")
                                {
                                    <span class="badge badge-soft-danger ms-1">Lost</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@opp.CustomerId" class="text-decoration-none text-dark">
                                    <i class="bi bi-building me-1 text-muted"></i>@opp.Customer?.CustomerName
                                </a>
                            </td>
                            <td>
                                @if (opp.Stage == "Won")
                                {
                                    <span class="badge badge-soft-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>Won</span>
                                }
                                else if (opp.Stage == "Lost")
                                {
                                    <span class="badge badge-soft-danger px-2 py-1"><i class="bi bi-x-circle me-1"></i>Lost</span>
                                }
                                else if (opp.Stage == "Negotiation")
                                {
                                    <span class="badge badge-soft-warning px-2 py-1">Negotiation</span>
                                }
                                else if (opp.Stage == "Proposal")
                                {
                                    <span class="badge badge-soft-info px-2 py-1">Proposal</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary px-2 py-1">Qualification</span>
                                }
                            </td>
                            <td class="fw-bold">₹@opp.Amount.ToString("N0")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @opp.Probability%"></div>
                                    </div>
                                    <span class="small text-muted">@opp.Probability%</span>
                                </div>
                            </td>
                            <td class="fw-semibold text-success">₹@opp.WeightedAmount.ToString("N0")</td>
                            <td>
                                <span class="small @(opp.Status == "Open" && opp.ExpectedCloseDate < DateTime.Today ? "text-danger fw-bold" : "text-secondary")">
                                    @opp.ExpectedCloseDate.ToString("dd MMM yyyy")
                                </span>
                            </td>
                            <td>
                                <span class="small text-secondary">
                                    <i class="bi bi-person me-1"></i>@(opp.AssignedToUser?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteOppModal-@opp.OpportunityId" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade text-start" id="deleteOppModal-@opp.OpportunityId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Opportunity</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to permanently delete opportunity <strong>@opp.OpportunityName</strong>?
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@opp.OpportunityId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                            No opportunities found matching the specified filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing <strong>@Model.Opportunities.Count</strong> of <strong>@Model.TotalItems</strong> deals</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
