@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Lead Details - " + Model.LeadName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0">@Model.LeadName</h3>
            <span class="badge bg-light text-dark border">@Model.LeadCode</span>
            @if (Model.Status == "Converted")
            {
                <span class="badge badge-soft-success px-3 py-1"><i class="bi bi-check-all me-1"></i>Converted to Customer</span>
            }
            else if (Model.Status == "Qualified")
            {
                <span class="badge badge-soft-primary px-3 py-1"><i class="bi bi-star-fill me-1"></i>Qualified</span>
            }
            else
            {
                <span class="badge badge-soft-secondary px-3 py-1">@Model.Status</span>
            }
        </div>
        <p class="text-muted small mb-0"><i class="bi bi-building me-1"></i>@(Model.CompanyName ?? "Independent") &bull; Captured @Model.CreatedDate.ToString("dd MMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer &amp; Opportunity
            </a>
        }
        else if (Model.ConvertedCustomerId.HasValue)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId" class="btn btn-outline-success btn-sm">
                <i class="bi bi-person-check-fill me-1"></i> View Converted Customer
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Lead
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Leads
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <!-- Contact Card -->
        <div class="crm-card p-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-person-lines-fill text-primary me-2"></i>Contact Information</h5>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-3">
                <li>
                    <span class="text-muted small d-block">Email</span>
                    <a href="mailto:@Model.Email" class="text-decoration-none fw-semibold">
                        <i class="bi bi-envelope me-1"></i>@Model.Email
                    </a>
                </li>
                <li>
                    <span class="text-muted small d-block">Phone</span>
                    <span class="fw-semibold"><i class="bi bi-telephone me-1"></i>@Model.Phone</span>
                </li>
                <li>
                    <span class="text-muted small d-block">Company</span>
                    <span class="fw-semibold"><i class="bi bi-building me-1"></i>@(Model.CompanyName ?? "—")</span>
                </li>
                <li>
                    <span class="text-muted small d-block">Lead Source</span>
                    <span class="badge bg-light text-dark border">@Model.Source</span>
                </li>
                <li>
                    <span class="text-muted small d-block">Priority</span>
                    <span class="badge @(Model.Priority == "High" ? "badge-soft-danger" : (Model.Priority == "Medium" ? "badge-soft-warning" : "badge-soft-secondary"))">
                        @Model.Priority
                    </span>
                </li>
                <li>
                    <span class="text-muted small d-block">Assigned Representative</span>
                    <span class="badge badge-soft-primary px-2 py-1">
                        <i class="bi bi-person me-1"></i>@(Model.AssignedToUser?.FullName ?? "Unassigned")
                    </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Pipeline Qualification Overview -->
        <div class="crm-card p-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-cash-stack text-primary me-2"></i>Commercial Opportunity Value</h5>
            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 mb-3">
                <div>
                    <span class="text-muted small d-block">Estimated Deal Potential</span>
                    <h3 class="fw-bold text-success mb-0">₹@Model.ExpectedValue.ToString("N0")</h3>
                </div>
                <div class="text-end">
                    <span class="text-muted small d-block">Current Status</span>
                    <span class="badge bg-primary fs-6 px-3 py-1">@Model.Status</span>
                </div>
            </div>

            <h6 class="fw-bold small text-muted text-uppercase mb-2">Internal Qualification Notes</h6>
            <div class="p-3 bg-white border rounded-3">
                <p class="mb-0 text-secondary">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes recorded for this lead." : Model.Notes)</p>
            </div>
        </div>

        @if (Model.Status != "Converted")
        {
            <div class="crm-card p-4 border-success border-opacity-25 bg-success bg-opacity-10">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-success mb-1"><i class="bi bi-trophy-fill me-2"></i>Ready to convert this lead?</h5>
                        <p class="small text-muted mb-0">Converting automatically provisions a master customer record and optionally creates an active pipeline opportunity.</p>
                    </div>
                    <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Convert Now
                    </a>
                </div>
            </div>
        }
    </div>
</div>
