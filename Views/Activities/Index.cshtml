@model AcxiomCRM.ViewModels.ActivityIndexViewModel
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-list-task text-primary me-2"></i>Activities Log</h3>
        <p class="text-muted small mb-0">Record and audit calls, client meetings, emails sent and sales tasks completed.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Log Activity
    </a>
</div>

<!-- Filters -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">Search Subject / Notes</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search keywords..." />
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Activity Type</label>
            <select name="typeFilter" class="form-select form-select-sm">
                <option value="">All Types</option>
                <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                <option value="Task" selected="@(Model.TypeFilter == "Task")">Task</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Status</label>
            <select name="statusFilter" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
            </select>
        </div>
        @if (ViewBag.UsersList != null)
        {
            <div class="col-md-2">
                <label class="form-label small text-muted">Logged By</label>
                <select name="assignedUserFilter" class="form-select form-select-sm" asp-items="ViewBag.UsersList">
                    <option value="">All Users</option>
                </select>
            </div>
        }
        <div class="col-md-2">
            <label class="form-label small text-muted">Date</label>
            <input type="date" name="dateFilter" value="@Model.DateFilter?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-1 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel-fill"></i></button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
        </div>
    </form>
</div>

<!-- Activities Table -->
<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Subject &amp; Description</th>
                    <th>Related Record</th>
                    <th>Activity Date</th>
                    <th>Status</th>
                    <th>User</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Activities.Any())
                {
                    @foreach (var a in Model.Activities)
                    {
                        <tr>
                            <td>
                                @if (a.ActivityType == "Call")
                                {
                                    <span class="badge badge-soft-info px-2 py-1"><i class="bi bi-telephone me-1"></i>Call</span>
                                }
                                else if (a.ActivityType == "Meeting")
                                {
                                    <span class="badge badge-soft-primary px-2 py-1"><i class="bi bi-people me-1"></i>Meeting</span>
                                }
                                else if (a.ActivityType == "Email")
                                {
                                    <span class="badge badge-soft-secondary px-2 py-1"><i class="bi bi-envelope me-1"></i>Email</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-warning px-2 py-1"><i class="bi bi-check2-square me-1"></i>Task</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@a.Subject</div>
                                @if (!string.IsNullOrWhiteSpace(a.Description))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 380px;">@a.Description</div>
                                }
                            </td>
                            <td>
                                @if (a.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@a.CustomerId" class="text-decoration-none small">
                                        <i class="bi bi-building me-1"></i>@a.Customer.CustomerName
                                    </a>
                                }
                                else if (a.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@a.LeadId" class="text-decoration-none small">
                                        <i class="bi bi-funnel me-1"></i>@a.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td><span class="small text-dark">@a.ActivityDate.ToString("dd MMM yyyy, hh:mm tt")</span></td>
                            <td>
                                @if (a.Status == "Completed")
                                {
                                    <span class="badge badge-soft-success px-2 py-1">Completed</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary px-2 py-1">@a.Status</span>
                                }
                            </td>
                            <td>
                                <span class="small text-secondary">
                                    <i class="bi bi-person me-1"></i>@(a.AssignedToUser?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@a.ActivityId" class="btn btn-outline-primary btn-sm me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteActModal-@a.ActivityId" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="deleteActModal-@a.ActivityId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title fw-bold text-danger">Delete Activity</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete activity <strong>@a.Subject</strong>?
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@a.ActivityId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                            No activity entries found matching the criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing <strong>@Model.Activities.Count</strong> of <strong>@Model.TotalItems</strong> entries</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-typeFilter="@Model.TypeFilter">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-typeFilter="@Model.TypeFilter">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-typeFilter="@Model.TypeFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
