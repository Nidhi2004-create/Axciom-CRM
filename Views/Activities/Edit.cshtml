@model AcxiomCRM.ViewModels.ActivityCreateEditViewModel
@{
    ViewData["Title"] = "Edit Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Sales Activity</h3>
                <p class="text-muted small mb-0">Update interaction details, outcome notes or status.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Activities
            </a>
        </div>

        <div class="crm-card p-4">
            <form asp-action="Edit" method="post" id="activityForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ActivityId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ActivityType" class="form-label">Activity Type <span class="text-danger">*</span></label>
                        <select asp-for="ActivityType" class="form-select">
                            <option value="Call">Phone Call</option>
                            <option value="Meeting">Client Meeting</option>
                            <option value="Email">Email Communication</option>
                            <option value="Task">Internal Task</option>
                        </select>
                        <span asp-validation-for="ActivityType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ActivityDate" class="form-label">Date &amp; Time <span class="text-danger">*</span></label>
                        <input asp-for="ActivityDate" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Subject" class="form-label">Subject / Header <span class="text-danger">*</span></label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Discussed proposal pricing with CFO" autofocus />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label">Related Customer</label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomersList">
                            <option value="">-- None / Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label">Related Lead</label>
                        <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadsList">
                            <option value="">-- None / Select Lead --</option>
                        </select>
                        <span asp-validation-for="LeadId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    @if (ViewBag.UsersList != null)
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label">Assigned Representative</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList">
                                <option value="">-- Select Representative --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    }

                    <div class="col-md-12">
                        <label asp-for="Description" class="form-label">Detailed Notes / Minutes</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Record key discussion points, customer feedback, deliverables..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-3">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Update Activity
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
