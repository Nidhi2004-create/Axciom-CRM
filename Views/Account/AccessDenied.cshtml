@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6 text-center">
        <div class="crm-card p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-slash-fill" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-dark">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have the required role or permissions to access this page or resource.
                If you believe this is an error, please reach out to your CRM Administrator.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
