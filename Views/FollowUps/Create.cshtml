@model AcxiomCRM.ViewModels.FollowUpCreateEditViewModel
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-calendar-plus text-primary me-2"></i>Schedule Follow-Up</h3>
                <p class="text-muted small mb-0">Plan a prospect interaction, call, demo meeting or client task.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Follow-Ups
            </a>
        </div>

        <div class="crm-card p-4">
            <form asp-action="Create" method="post" id="followUpForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="Subject" class="form-label">Subject / Agenda <span class="text-danger">*</span></label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Solution architecture demo call" autofocus />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FollowUpType" class="form-label">Type <span class="text-danger">*</span></label>
                        <select asp-for="FollowUpType" class="form-select">
                            <option value="Call">Call</option>
                            <option value="Meeting">Meeting</option>
                            <option value="Email">Email</option>
                            <option value="Task">Task</option>
                        </select>
                        <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FollowUpDate" class="form-label">Scheduled Date &amp; Time <span class="text-danger">*</span></label>
                        <input asp-for="FollowUpDate" class="form-control" type="datetime-local" min="@DateTime.Today.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        <div class="form-text small text-muted">Cannot be earlier than today for new follow-ups.</div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CustomerId" class="form-label">Related Customer (Optional)</label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomersList">
                            <option value="">-- None --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="LeadId" class="form-label">Related Lead (Optional)</label>
                        <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadsList">
                            <option value="">-- None --</option>
                        </select>
                        <span asp-validation-for="LeadId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="OpportunityId" class="form-label">Related Deal (Optional)</label>
                        <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.OpportunitiesList">
                            <option value="">-- None --</option>
                        </select>
                        <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label">Assign To</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList">
                                <option value="">-- Assign to User --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label">Remarks &amp; Preparation Notes</label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Key talking points or deliverables..."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Save Follow-Up
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
