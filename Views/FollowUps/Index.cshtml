@model AcxiomCRM.ViewModels.FollowUpIndexViewModel
@{
    ViewData["Title"] = "Follow-Up Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-calendar-check-fill text-primary me-2"></i>Follow-Ups &amp; Reminders</h3>
        <p class="text-muted small mb-0">Manage prospect and customer touchpoints, meetings, calls and task deadlines.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Follow-Up KPI Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="crm-card crm-kpi-card border-danger border-opacity-25">
            <div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Overdue Follow-Ups</span>
                <h4 class="fw-bold text-danger mb-0">@Model.OverdueCount</h4>
            </div>
            <div class="crm-kpi-icon badge-soft-danger">
                <i class="bi bi-exclamation-octagon-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="crm-card crm-kpi-card">
            <div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Upcoming Planned</span>
                <h4 class="fw-bold text-primary mb-0">@Model.UpcomingCount</h4>
            </div>
            <div class="crm-kpi-icon badge-soft-primary">
                <i class="bi bi-calendar-event"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="crm-card crm-kpi-card">
            <div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Completed Touchpoints</span>
                <h4 class="fw-bold text-success mb-0">@Model.CompletedCount</h4>
            </div>
            <div class="crm-kpi-icon badge-soft-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">Search Subject / Record</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search keywords..." />
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Status</label>
            <select name="statusFilter" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Overdue" selected="@(Model.StatusFilter == "Overdue")">Overdue Only</option>
                <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Type</label>
            <select name="typeFilter" class="form-select form-select-sm">
                <option value="">All Types</option>
                <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                <option value="Task" selected="@(Model.TypeFilter == "Task")">Task</option>
            </select>
        </div>
        @if (ViewBag.UsersList != null)
        {
            <div class="col-md-2">
                <label class="form-label small text-muted">Assigned User</label>
                <select name="assignedUserFilter" class="form-select form-select-sm" asp-items="ViewBag.UsersList">
                    <option value="">All Users</option>
                </select>
            </div>
        }
        <div class="col-md-2">
            <label class="form-label small text-muted">Date</label>
            <input type="date" name="dateFilter" value="@Model.DateFilter?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-1 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel-fill"></i></button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
        </div>
    </form>
</div>

<!-- FollowUps Table -->
<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Scheduled Date &amp; Time</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FollowUps.Any())
                {
                    @foreach (var f in Model.FollowUps)
                    {
                        bool isOverdue = f.Status == "Planned" && f.FollowUpDate < DateTime.UtcNow;
                        <tr>
                            <td>
                                @if (f.FollowUpType == "Call")
                                {
                                    <span class="badge badge-soft-info px-2 py-1"><i class="bi bi-telephone me-1"></i>Call</span>
                                }
                                else if (f.FollowUpType == "Meeting")
                                {
                                    <span class="badge badge-soft-primary px-2 py-1"><i class="bi bi-people me-1"></i>Meeting</span>
                                }
                                else if (f.FollowUpType == "Email")
                                {
                                    <span class="badge badge-soft-secondary px-2 py-1"><i class="bi bi-envelope me-1"></i>Email</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-warning px-2 py-1"><i class="bi bi-check2-square me-1"></i>Task</span>
                                }
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">@f.Subject</span>
                                @if (!string.IsNullOrEmpty(f.Remarks))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 280px;">@f.Remarks</div>
                                }
                            </td>
                            <td>
                                @if (f.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="text-decoration-none small">
                                        <i class="bi bi-building me-1"></i>@f.Customer.CustomerName
                                    </a>
                                }
                                else if (f.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="text-decoration-none small">
                                        <i class="bi bi-funnel me-1"></i>@f.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <span class="small @(isOverdue ? "text-danger fw-bold" : "text-dark")">
                                    <i class="bi bi-clock me-1"></i>@f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                                @if (isOverdue)
                                {
                                    <span class="badge badge-soft-danger small ms-1">Overdue</span>
                                }
                            </td>
                            <td>
                                @if (f.Status == "Completed")
                                {
                                    <span class="badge badge-soft-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                }
                                else if (f.Status == "Cancelled")
                                {
                                    <span class="badge badge-soft-secondary px-2 py-1">Cancelled</span>
                                }
                                else if (isOverdue)
                                {
                                    <span class="badge badge-soft-danger px-2 py-1">Pending (Overdue)</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-primary px-2 py-1">Planned</span>
                                }
                            </td>
                            <td>
                                <span class="small text-secondary">
                                    <i class="bi bi-person me-1"></i>@(f.AssignedToUser?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (f.Status == "Planned")
                                    {
                                        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@f.FollowUpId" title="Mark Complete">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-warning text-dark" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@f.FollowUpId" title="Reschedule">
                                            <i class="bi bi-calendar-plus"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteFollowUpModal-@f.FollowUpId" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Complete Modal -->
                                <div class="modal fade text-start" id="completeModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header border-0">
                                                    <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle me-2"></i>Complete Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-2">Mark follow-up <strong>@f.Subject</strong> as completed.</p>
                                                    <label class="form-label small text-muted">Completion Notes &amp; Outcome</label>
                                                    <textarea name="completionNotes" class="form-control" rows="3" placeholder="Enter meeting summary or call result..."></textarea>
                                                </div>
                                                <div class="modal-footer border-0">
                                                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success btn-sm">Complete Follow-Up</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reschedule Modal -->
                                <div class="modal fade text-start" id="rescheduleModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="Reschedule" asp-route-id="@f.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header border-0">
                                                    <h5 class="modal-title fw-bold text-warning text-dark"><i class="bi bi-clock-history me-2"></i>Reschedule Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label small text-muted">New Follow-Up Date &amp; Time</label>
                                                        <input type="datetime-local" name="newDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-ddTHH:mm")" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-ddT10:00")" required />
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small text-muted">Reason for Rescheduling</label>
                                                        <input type="text" name="reason" class="form-control" placeholder="Client requested change, out of office..." />
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0">
                                                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary btn-sm">Save Reschedule</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="deleteFollowUpModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title fw-bold text-danger">Delete Follow-Up</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete follow-up <strong>@f.Subject</strong>?
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                            No follow-up items found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing <strong>@Model.FollowUps.Count</strong> of <strong>@Model.TotalItems</strong> follow-ups</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
