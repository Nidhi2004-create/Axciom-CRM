@model AcxiomCRM.ViewModels.CustomerCreateEditViewModel
@{
    ViewData["Title"] = "Add Customer";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-person-plus-fill text-primary me-2"></i>New Customer</h3>
                <p class="text-muted small mb-0">Fill in the mandatory customer master records and contact information.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Customers
            </a>
        </div>

        <div class="crm-card p-4">
            <form asp-action="Create" method="post" id="customerForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <!-- Customer Name -->
                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label">Customer Name <span class="text-danger">*</span></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="e.g. Acme Innovations Pvt Ltd" autofocus />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <!-- Company Name -->
                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label">Company Name</label>
                        <input asp-for="CompanyName" class="form-control" placeholder="e.g. Acme Corp" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="contact@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="Phone" class="form-control" placeholder="10-digit number e.g. 9876543210" maxlength="10" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                        <div class="form-text small text-muted">10-digit Indian mobile number starting with 6, 7, 8, or 9.</div>
                    </div>

                    <!-- Address -->
                    <div class="col-12">
                        <label asp-for="Address" class="form-label">Street Address</label>
                        <input asp-for="Address" class="form-control" placeholder="Suite, Street address" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <!-- City & State -->
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" placeholder="e.g. Mumbai, Bengaluru" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="State" class="form-label">State</label>
                        <input asp-for="State" class="form-control" placeholder="e.g. Maharashtra, Karnataka" />
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>

                    <!-- Status & Assigned Owner -->
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="col-md-6">
                            <label asp-for="CreatedBy" class="form-label">Assign Account Owner</label>
                            <select asp-for="CreatedBy" class="form-select" asp-items="ViewBag.UsersList">
                                <option value="">-- Assign to User --</option>
                            </select>
                            <span asp-validation-for="CreatedBy" class="text-danger small"></span>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Save Customer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
