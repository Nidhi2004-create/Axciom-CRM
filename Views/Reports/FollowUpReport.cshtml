@model List<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-calendar-check-fill text-warning me-2"></i>Follow-Up &amp; Touchpoint Report</h3>
        <p class="text-muted small mb-0">Audit of planned, completed, missed and overdue client communication activities.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="FollowUpReport" asp-route-status="@ViewBag.Status" asp-route-type="@ViewBag.Type" asp-route-startDate="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : null)" asp-route-endDate="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : null)" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Hub</a>
    </div>
</div>

<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="FollowUpReport" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Planned" selected="@(ViewBag.Status == "Planned")">Planned</option>
                <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                <option value="Missed" selected="@(ViewBag.Status == "Missed")">Missed</option>
                <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Type</label>
            <select name="type" class="form-select form-select-sm">
                <option value="">All Types</option>
                <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                <option value="Task" selected="@(ViewBag.Type == "Task")">Task</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">From Date</label>
            <input type="date" name="startDate" value="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : null)" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">To Date</label>
            <input type="date" name="endDate" value="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : null)" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel-fill me-1"></i>Filter</button>
            <a asp-action="FollowUpReport" class="btn btn-sm btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
        </div>
    </form>
</div>

<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related Customer</th>
                    <th>Scheduled Date</th>
                    <th>Status</th>
                    <th>Assigned User</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                        <td class="fw-semibold text-dark">@f.Subject</td>
                        <td>@(f.Customer?.CustomerName ?? "—")</td>
                        <td><span class="small font-monospace">@f.FollowUpDate.ToString("dd MMM yyyy, HH:mm")</span></td>
                        <td>
                            @if (f.Status == "Completed")
                            {
                                <span class="badge badge-soft-success">Completed</span>
                            }
                            else if (f.Status == "Planned" && f.FollowUpDate < DateTime.UtcNow)
                            {
                                <span class="badge badge-soft-danger">Overdue</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-primary">@f.Status</span>
                            }
                        </td>
                        <td><span class="small text-secondary">@(f.AssignedToUser?.FullName ?? "Unassigned")</span></td>
                        <td><span class="small text-muted text-truncate d-inline-block" style="max-width: 250px;">@(f.Remarks ?? "—")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
