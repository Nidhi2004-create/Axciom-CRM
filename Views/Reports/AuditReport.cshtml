@model List<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Security & Audit Events Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-danger me-2"></i>Security &amp; Audit Events Report</h3>
        <p class="text-muted small mb-0">Append-oriented records of system authentications, permission modifications and CRUD activity.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AuditReport" asp-route-action="@ViewBag.Action" asp-route-startDate="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : null)" asp-route-endDate="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : null)" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Hub</a>
    </div>
</div>

<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="AuditReport" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">Action</label>
            <select name="action" class="form-select form-select-sm">
                <option value="">All Actions</option>
                <option value="Login" selected="@(ViewBag.Action == "Login")">Login</option>
                <option value="Failed Login" selected="@(ViewBag.Action == "Failed Login")">Failed Login</option>
                <option value="Logout" selected="@(ViewBag.Action == "Logout")">Logout</option>
                <option value="Create" selected="@(ViewBag.Action == "Create")">Create</option>
                <option value="Update" selected="@(ViewBag.Action == "Update")">Update</option>
                <option value="Delete" selected="@(ViewBag.Action == "Delete")">Delete</option>
                <option value="Role Change" selected="@(ViewBag.Action == "Role Change")">Role Change</option>
                <option value="Security" selected="@(ViewBag.Action == "Security")">Security</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">From Date</label>
            <input type="date" name="startDate" value="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : null)" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">To Date</label>
            <input type="date" name="endDate" value="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : null)" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel-fill me-1"></i>Filter</button>
            <a asp-action="AuditReport" class="btn btn-sm btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
        </div>
    </form>
</div>

<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Record ID</th>
                    <th>Result</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><span class="small font-monospace">@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</span></td>
                        <td class="fw-semibold">@(a.UserName ?? "System")</td>
                        <td><span class="badge badge-soft-secondary">@a.Action</span></td>
                        <td><span class="badge bg-light text-dark border">@a.EntityName</span></td>
                        <td><span class="small font-monospace">@(a.RecordId ?? "—")</span></td>
                        <td>
                            @if (a.Result == "Success")
                            {
                                <span class="badge badge-soft-success">Success</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-danger">@a.Result</span>
                            }
                        </td>
                        <td><span class="small text-muted text-truncate d-inline-block" style="max-width: 320px;">@a.Details</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
