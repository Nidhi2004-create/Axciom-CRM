@model List<AcxiomCRM.ViewModels.UserActivitySummary>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-primary me-2"></i>User Activity Report</h3>
        <p class="text-muted small mb-0">Summary of client meetings held, calls completed, emails sent and sales tasks closed per team member.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="UserActivityReport" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Hub</a>
    </div>
</div>

<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User Name</th>
                    <th>Role</th>
                    <th>Calls Made</th>
                    <th>Meetings Held</th>
                    <th>Emails Sent</th>
                    <th>Tasks Completed</th>
                    <th>Total Touchpoints</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold text-dark">@u.UserName</td>
                        <td><span class="badge bg-light text-secondary border">@u.Role</span></td>
                        <td><span class="badge badge-soft-info px-2 py-1"><i class="bi bi-telephone me-1"></i>@u.CallsCount</span></td>
                        <td><span class="badge badge-soft-primary px-2 py-1"><i class="bi bi-people me-1"></i>@u.MeetingsCount</span></td>
                        <td><span class="badge badge-soft-secondary px-2 py-1"><i class="bi bi-envelope me-1"></i>@u.EmailsCount</span></td>
                        <td><span class="badge badge-soft-warning px-2 py-1"><i class="bi bi-check2-square me-1"></i>@u.TasksCount</span></td>
                        <td class="fw-bold text-primary fs-6">@u.TotalActivities</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
