@model List<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Customer Master Report</h3>
        <p class="text-muted small mb-0">List of customers with status, assigned account owner and account creation dates.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CustomerReport" asp-route-status="@ViewBag.Status" asp-route-startDate="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : null)" asp-route-endDate="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : null)" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Hub</a>
    </div>
</div>

<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="CustomerReport" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Created From</label>
            <input type="date" name="startDate" value="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : null)" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Created To</label>
            <input type="date" name="endDate" value="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : null)" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel-fill me-1"></i>Filter</button>
            <a asp-action="CustomerReport" class="btn btn-sm btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
        </div>
    </form>
</div>

<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Account Owner</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                        <td class="fw-semibold text-primary">@c.CustomerName</td>
                        <td>@(c.CompanyName ?? "—")</td>
                        <td><span class="small text-muted">@c.Email</span></td>
                        <td><span class="small text-muted">@c.Phone</span></td>
                        <td>
                            <span class="badge @(c.Status == "Active" ? "badge-soft-success" : "badge-soft-secondary")">@c.Status</span>
                        </td>
                        <td><span class="small text-secondary">@(c.CreatedByUser?.FullName ?? "Unassigned")</span></td>
                        <td><span class="small text-muted">@c.CreatedDate.ToString("dd MMM yyyy")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
