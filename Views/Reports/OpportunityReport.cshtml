@model List<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-briefcase-fill text-success me-2"></i>Opportunity &amp; Stage Report</h3>
        <p class="text-muted small mb-0">Stage distribution, deal amounts, probabilities and forecasted closing schedules.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="OpportunityReport" asp-route-stage="@ViewBag.Stage" asp-route-status="@ViewBag.Status" asp-route-startDate="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : null)" asp-route-endDate="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : null)" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Hub</a>
    </div>
</div>

<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="OpportunityReport" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">Stage</label>
            <select name="stage" class="form-select form-select-sm">
                <option value="">All Stages</option>
                <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">From Date</label>
            <input type="date" name="startDate" value="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : null)" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">To Date</label>
            <input type="date" name="endDate" value="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : null)" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel-fill me-1"></i>Filter</button>
            <a asp-action="OpportunityReport" class="btn btn-sm btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
        </div>
    </form>
</div>

<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Opportunity</th>
                    <th>Customer</th>
                    <th>Stage</th>
                    <th>Amount</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Owner</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="fw-semibold text-primary">@o.OpportunityName</td>
                        <td>@(o.Customer?.CustomerName ?? "—")</td>
                        <td><span class="badge badge-soft-info">@o.Stage</span></td>
                        <td class="fw-bold">₹@o.Amount.ToString("N0")</td>
                        <td>@o.Probability%</td>
                        <td class="fw-semibold text-success">₹@o.WeightedAmount.ToString("N0")</td>
                        <td><span class="small text-muted">@o.ExpectedCloseDate.ToString("dd MMM yyyy")</span></td>
                        <td><span class="small text-secondary">@(o.AssignedToUser?.FullName ?? "Unassigned")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
