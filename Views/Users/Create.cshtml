@model AcxiomCRM.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Provision User";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-person-plus-fill text-primary me-2"></i>Provision User</h3>
                <p class="text-muted small mb-0">Create a new CRM user and assign authorization privileges.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Users
            </a>
        </div>

        <div class="crm-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Rachel Adams" autofocus />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Work Email / Username <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" placeholder="rachel@acxiom.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Role Assignment <span class="text-danger">*</span></label>
                    <select asp-for="Role" class="form-select">
                        <option value="SalesExecutive">Sales Executive (Own records only)</option>
                        <option value="Manager">Manager (Team &amp; Reporting scope)</option>
                        <option value="Admin">Administrator (Full System &amp; Security)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Initial Password <span class="text-danger">*</span></label>
                    <input asp-for="Password" class="form-control" placeholder="Min 8 chars, 1 upper, 1 digit, 1 symbol" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active Account</label>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Provision User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
