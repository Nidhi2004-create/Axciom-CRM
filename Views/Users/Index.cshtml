@model List<AcxiomCRM.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-gear text-primary me-2"></i>User &amp; Role Management</h3>
        <p class="text-muted small mb-0">System access control, role assignments, lockout management and security administration.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Provision New User
    </a>
</div>

<!-- Filter Ribbon -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small text-muted">Search User Name or Email</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search users..." />
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label small text-muted">Role Filter</label>
            <select name="roleFilter" class="form-select form-select-sm">
                <option value="">All Roles</option>
                <option value="Admin" selected="@(ViewBag.RoleFilter == "Admin")">Admin</option>
                <option value="Manager" selected="@(ViewBag.RoleFilter == "Manager")">Manager</option>
                <option value="SalesExecutive" selected="@(ViewBag.RoleFilter == "SalesExecutive")">Sales Executive</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel-fill me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Email / Username</th>
                    <th>Assigned Role</th>
                    <th>Account Status</th>
                    <th>Lockout State</th>
                    <th>Created Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold text-dark">@user.FullName</div>
                        </td>
                        <td><span class="text-muted small">@user.Email</span></td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else if (user.Role == "Manager")
                            {
                                <span class="badge bg-warning text-dark">Manager</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Sales Executive</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge badge-soft-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-danger px-2 py-1"><i class="bi bi-dash-circle me-1"></i>Deactivated</span>
                            }
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge badge-soft-danger px-2 py-1" title="Locked until @user.LockoutEnd">
                                    <i class="bi bi-lock-fill me-1"></i>Locked
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-secondary px-2 py-1"><i class="bi bi-unlock me-1"></i>Normal</span>
                            }
                        </td>
                        <td><span class="small text-muted">@user.CreatedDate.ToString("dd MMM yyyy")</span></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit User">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </a>
                                @if (user.IsLockedOut)
                                {
                                    <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-warning text-dark" title="Unlock Account">
                                            <i class="bi bi-unlock-fill"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(user.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
